# Copy to .env.local for local dev (never commit .env.local)

# Supabase — free cloud DB so everyone sees the same board
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: require ?key=THIS_VALUE to edit (view link always works with ?mode=view)
VITE_EDIT_KEY=choose-a-secret-team-password
